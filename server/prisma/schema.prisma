datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(uuid())
  name                String
  phone               String               @unique
  language            String               @default("en") // en, kn, ta, te
  state               String               @default("Karnataka")
  district            String               @default("Mandya")
  village             String?
  farmSize            Float?               @default(2.5)
  farmUnit            String               @default("Acres") // Acres, Guntha, Bigha, Hectare
  avatar              String?
  latitude            Float?
  longitude           Float?
  taluk               String?
  locationAccuracy    Float?               // metres
  locationSource      String?              // gps | ip | manual
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  soilAssessments     SoilAssessment[]
  cropRecommendations CropRecommendation[]
  cropPlans           CropPlan[]
  chatConversations   ChatConversation[]
  reminders           Reminder[]
}

model SoilAssessment {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  state               String
  district            String
  village             String?
  farmSize            Float
  farmUnit            String               @default("Acres")
  soilType            String               // red, black, sandy, clay, loamy, alluvial, laterite, unknown
  soilColour          String?              // red, dark_brown, black, yellowish, light_grey
  soilTexture         String?              // fine_clayey, medium_loamy, coarse_sandy, silty
  moistureLevel       String?              // dry, slightly_moist, optimal, wet_waterlogged
  organicMatter       String?              // low, medium, high
  taluk               String?
  landSizeGuntas      Float?
  category            String?              // preferred crop category
  ph                  Float?
  nitrogen            Float?
  phosphorus          Float?
  potassium           Float?
  npkNitrogen         String?              // Low, Medium, High
  npkPhosphorus       String?              // Low, Medium, High
  npkPotassium        String?              // Low, Medium, High
  waterSource         String               // rainfed, borewell, canal, tank, other
  irrigationType      String?              // drip, sprinkler, flood, furrow, none
  season              String               // Kharif, Rabi, Zaid, Year-round
  sowingMonth         String?
  previousCrop        String?
  budget              String?              // low, medium, high
  drainage            String?              // good, moderate, poor, waterlogged
  soilIssues          String?              // salinity, acidity, erosion, hardpan, none
  createdAt           DateTime             @default(now())

  cropRecommendations CropRecommendation[]
}

model Crop {
  id                  String     @id @default(uuid())
  name                String
  scientificName      String?
  nameKannada         String
  nameTamil           String
  nameTelugu          String
  category            String     // cereal, millet, pulse, commercial, vegetable, oilseed
  idealSoilTypes      String     // JSON array of strings e.g. ["clay", "loamy", "black"]
  minPh               Float      @default(5.5)
  maxPh               Float      @default(7.5)
  waterRequirement    String     // Low, Moderate, High
  waterMm             String?    // e.g. "450-650 mm"
  durationDays        String     // e.g. "100-120 days"
  durationMin         Int        @default(100)
  durationMax         Int        @default(120)
  seasons             String     // JSON array e.g. ["Kharif", "Rabi"]
  minTemp             Float      @default(20.0)
  maxTemp             Float      @default(35.0)
  rainfallMm          String?
  estimatedCostPerAcre String    // e.g. "₹18,000 - ₹25,000"
  potentialYieldPerAcre String   // e.g. "20-25 Quintals"
  marketDemand        String     // High, Moderate, Very High
  description         String
  descriptionKn       String?
  descriptionTa       String?
  descriptionTe       String?
  imageUrl            String?
  imageSource         String?
  imageAuthor         String?
  imageLicence        String?
  imageAttribution    String?
  risks               String     // JSON array of strings
  benefits            String     // JSON array of strings
  createdAt           DateTime   @default(now())

  cropPlans           CropPlan[]
  problemCrops        ProblemCrop[]
}

model CropRecommendation {
  id                  String          @id @default(uuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  soilAssessmentId    String?
  soilAssessment      SoilAssessment? @relation(fields: [soilAssessmentId], references: [id], onDelete: SetNull)
  results             String          // JSON stored recommendation payload
  createdAt           DateTime        @default(now())
}

model CropPlan {
  id                  String     @id @default(uuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId              String
  crop                Crop       @relation(fields: [cropId], references: [id], onDelete: Cascade)
  cropName            String
  startDate           DateTime   @default(now())
  status              String     @default("active") // active, completed, abandoned
  fieldName           String?    @default("Main Field")
  areaAcre            Float?     @default(1.0)
  currentStageIndex   Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tasks               CropTask[]
}

model CropTask {
  id                  String    @id @default(uuid())
  cropPlanId          String
  cropPlan            CropPlan  @relation(fields: [cropPlanId], references: [id], onDelete: Cascade)
  stage               String    // Land Preparation, Sowing, Germination, Vegetative Growth, Flowering, Grain Development, Harvesting, Storage
  stageOrder          Int
  title               String
  titleKn             String?
  titleTa             String?
  titleTe             String?
  description         String
  descriptionKn       String?
  descriptionTa       String?
  descriptionTe       String?
  dayOffset           Int       @default(1)
  dayRange            String    // e.g. "Day 1 - 7"
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  category            String    // preparation, sowing, irrigation, nutrient, weed, pest, harvest
  materialsNeeded     String?   // JSON array e.g. ["Tractor / Plough", "Labour"]
  importantTip        String?
  importantTipKn      String?
  importantTipTa      String?
  importantTipTe      String?
}

model Problem {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  name                  String
  nameKn                String
  nameTa                String
  nameTe                String
  scientificName        String?
  type                  String            // insect_pest | fungal | bacterial | viral | nematode | mite | weed | nutrient_deficiency | abiotic_stress
  severity              String            // low | medium | high | critical
  symptoms              String
  symptomsKn            String?
  symptomsTa            String?
  symptomsTe            String?
  cause                 String?
  favourableConditions  String?
  favourableHumidity    String?           // e.g. ">85%"
  favourableTemp        String?           // e.g. "25-30°C"
  favourableSeasons     String?           // JSON array e.g. ["Kharif", "Rabi"]
  affectedStages        String            // JSON array e.g. ["Vegetative Growth", "Flowering"]
  spreadPattern         String?           // e.g. "Airborne spores", "Soil-borne", "Insect vector"
  culturalControl       String?
  culturalControlKn     String?
  culturalControlTa     String?
  culturalControlTe     String?
  biologicalControl     String?
  biologicalControlKn   String?
  biologicalControlTa   String?
  biologicalControlTe   String?
  organicControl        String?
  organicControlKn      String?
  organicControlTa      String?
  organicControlTe      String?
  chemicalControl       String?           // Generic active ingredient names only + label note
  chemicalControlKn     String?
  chemicalControlTa     String?
  chemicalControlTe     String?
  preventionSteps       String            // JSON array of strings
  preventionStepsKn     String?
  preventionStepsTa     String?
  preventionStepsTe     String?
  ipmSteps              String            // JSON array of IPM ladder steps
  ipmStepsKn            String?
  ipmStepsTa            String?
  ipmStepsTe            String?
  safetyNotes           String?           // PPE, withholding period (PHI), pollinator safety
  lookAlikes            String?           // JSON array of { name, difference, lookAlikeSlug? }
  whenToCallExpert      String?           // ETL threshold or severe atypical advisory
  whenToCallExpertKn    String?
  whenToCallExpertTa    String?
  whenToCallExpertTe    String?
  confidence            String            @default("verified") // verified | review_needed | low
  sources               String?           // ICAR, UAS Bangalore, TNAU, etc.
  verified              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  crops                 ProblemCrop[]
  symptomTags           ProblemSymptom[]
  images                ProblemImage[]
}

model SymptomTag {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  plantPart             String            // leaf, stem, root, fruit_grain, flower, whole_plant
  pattern               String            // spots, streaks, yellowing, browning, wilting, holes, rolling_curling, powdery_mould, rot, galls, dead_heart, stunting, insects_visible
  colour                String?           // yellow, brown, black, white, grey, red_purple, light_green
  spread                String?           // few_plants, patches, whole_field
  stage                 String?           // seedling, vegetative, flowering, maturity
  labelEn               String
  labelKn               String
  labelTa               String
  labelTe               String
  icon                  String?

  problems              ProblemSymptom[]
}

model ProblemSymptom {
  id                    String            @id @default(uuid())
  problemId             String
  problem               Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  symptomTagId          String
  symptomTag            SymptomTag        @relation(fields: [symptomTagId], references: [id], onDelete: Cascade)
  weight                Float             @default(1.0)
  isPrimary             Boolean           @default(false)

  @@unique([problemId, symptomTagId])
}

model ProblemCrop {
  id                    String            @id @default(uuid())
  problemId             String
  problem               Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  cropId                String?
  crop                  Crop?             @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropName              String            // e.g. "Paddy (Rice)"
  cropSlug              String            // e.g. "paddy"
  importance            String            @default("primary") // primary | secondary | minor

  @@unique([problemId, cropSlug])
}

model ProblemImage {
  id                    String            @id @default(uuid())
  problemId             String
  problem               Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  path                  String            // Local relative path e.g. "/problems/yellow-stem-borer/dead-heart.webp"
  caption               String
  captionKn             String?
  captionTa             String?
  captionTe             String?
  kind                  String            // symptom_closeup | field_view | pest_or_pathogen | healthy_comparison
  source                String?           // Wikimedia Commons, ICAR, etc.
  author                String?
  licence               String?           // CC BY 4.0, CC BY-SA 3.0, Public Domain, etc.
  attribution           String?
  isPrimary             Boolean           @default(false)
}

model DiseaseKnowledge {
  id                  String   @id @default(uuid())
  name                String
  nameKannada         String
  nameTamil           String
  nameTelugu          String
  affectedCrops       String   // JSON array e.g. ["Paddy (Rice)", "Wheat"]
  symptoms            String
  symptomsKn          String?
  symptomsTa          String?
  symptomsTe          String?
  conditions          String
  prevention          String
  preventionKn        String?
  preventionTa        String?
  preventionTe        String?
  ipmSteps            String   // JSON array of strings
  ipmStepsKn          String?
  ipmStepsTa          String?
  ipmStepsTe          String?
  expertAdvice        String
  severity            String   // low, medium, high, critical
  imageUrl            String?
  imageSource         String?
  imageAuthor         String?
  imageLicence        String?
  imageAttribution    String?
}

model ChatConversation {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String        @default("Farming Query")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  messages            ChatMessage[]
}

model ChatMessage {
  id                  String           @id @default(uuid())
  conversationId      String
  conversation        ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                String           // user, assistant, system
  content             String
  language            String           @default("en")
  mode                String           @default("local") // local or gemini
  createdAt           DateTime         @default(now())
}

model Reminder {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  message             String
  dueDate             DateTime
  isRead              Boolean   @default(false)
  createdAt           DateTime  @default(now())
}

model WeatherAlert {
  id                  String    @id @default(uuid())
  district            String
  title               String
  titleKn             String?
  titleTa             String?
  titleTe             String?
  severity            String    // info, warning, severe
  message             String
  messageKn           String?
  messageTa           String?
  messageTe           String?
  validUntil          DateTime
}

model DiagnosisFeedback {
  id                  String    @id @default(uuid())
  problemSlug         String    // Predicted top candidate slug
  confidence          String    // high | medium | low
  crop                String    // Crop name or slug
  rating              String    // correct | incorrect | not_sure
  farmerCorrection    String?   // Correct problem slug if marked incorrect
  notes               String?
  hasConsent          Boolean   @default(false)
  storedImagePath     String?   // Only populated if farmer explicitly consented to save photo
  createdAt           DateTime  @default(now())
}

