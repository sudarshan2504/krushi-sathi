PORT=5000
NODE_ENV=development
DATABASE_URL="file:./krishi_sathi.db"
JWT_SECRET="replace-with-a-long-random-jwt-secret-min-32-chars"

# Demo login (/api/auth/demo-login) and Demo OTP toggle:
# Set DEMO_MODE="true" ONLY for local/workshop demo environments (returns 404 when false).
DEMO_MODE="false"
# Set DEMO_OTP_ENABLED="true" only if you want /api/auth/send-otp and /api/auth/verify-otp demo OTP active in development.
# In production, or when set to 'false', the demo OTP route returns 404/disabled.
DEMO_OTP_ENABLED="false"
DEMO_OTP="123456"

# Firebase Admin Configuration (For Real Phone Number OTP Verification)
# 1. FIREBASE_PROJECT_ID: Your Firebase project ID (e.g. krushi-sathi-12345)
#    Found in Firebase Console > Project Settings > General.
FIREBASE_PROJECT_ID="your_firebase_project_id"

# 2. Service Account Credentials (Optional for local token verification, recommended for production):
#    Generated from Firebase Console > Project Settings > Service accounts > Generate new private key.
#    Paste client_email and private_key from the downloaded JSON file.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Self-Hosted Android SMS Gateway (https://github.com/mdakashhossain1/SMS-Gateway-Free)
# Turns any Android device with an active SIM into a private, zero-cost SMS OTP gateway.
# Install SMS-Gateway-Device.apk on the phone, start the server in the app, and paste details here:
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
# If left blank, the app will safely run in local demo agronomy mode.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Official Government Agricultural Market Data (data.gov.in / AGMARKNET)
# Register for a free API key at: https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=""
MANDI_API_BASE_URL="https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070"
MANDI_SYNC_INTERVAL_HOURS=6

CLIENT_URL="http://localhost:5173"
