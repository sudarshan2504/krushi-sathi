# Firebase Authentication Web SDK Configuration
# Obtain these values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here

# Google Maps JavaScript API (Optional - Interactive Farm Location Map)
# If omitted, Krushi Sathi provides an interactive satellite canvas with GPS geolocation
# and cascading State -> District -> Taluk dropdown fallbacks.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
